<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- realme GT Neo5 SE (RMX3700, Qualcomm sm8475/waipio) -->

  <remote name="stxlvn" fetch="https://github.com/stxlvn/" />
  <remote name="realme" fetch="https://github.com/realme-kernel-opensource/" />
  <default remote="stxlvn" revision="master" sync-j="8" />

  <!-- RedUnion kernel source: real ACK history rebased 209->264, full
       preserved git history, SukiSU-Ultra + SUSFS + KPM + BBRv3 + LZ4KD.
       This is the build root (build_redunion.sh lives here). -->
  <project remote="stxlvn" name="gt_neo5se_common_source" path="gt_neo5se_common_source" revision="master" />

  <!-- Unmodified OPLUS vendor drivers/blobs (e.g. drivers/soc/oplus/storage)
       this kernel's build_redunion.sh expects via VENDOR_ROOT, synced as a
       sibling directory named "vendor". -->
  <project remote="realme" name="realme_gt_neo5se-AndroidV-vendor-source" path="vendor" revision="master" />

</manifest>
